# Copy to .env (git-ignored). No secrets needed: the model is public.
# Absolute path of the downloaded Kolibri-1 directory (contains config.json)
MODEL_DIR=/path/to/models/Aleph-Alpha/Kolibri-1
PORT=8000
# Keep 127.0.0.1 unless you need LAN access (the API has no authentication)
BIND_ADDR=127.0.0.1
GMEM=0.78
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=4
# HF_TOKEN=   # only for the download step, export it in your shell instead of storing it here
